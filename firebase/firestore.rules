rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Volunteer-keyed course records. Access is gated in the app by volunteer
    // access codes + Volunteer ID. Google Auth is optional and must not block volunteers.
    match /course_progress/{docId} {
      allow read, write: if true;
    }

    match /volunteer_ids/{docId} {
      allow read, write: if true;
    }

    match /volunteer_counters/{docId} {
      allow read, write: if true;
    }
  }
}
