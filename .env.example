VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Nonprofit admin (/admin) — password only, default axiom123 if unset
VITE_ADMIN_PASSWORD=axiom123

# Course site link back to main nonprofit website (optional)
# If the course is hosted on a separate domain, set this on the main website:
# VITE_COURSE_URL=https://axiom-research-foundations.vercel.app/learn

# VITE_AXIOM_WEBSITE_URL=https://your-axiom-site.vercel.app

# Course LMS (Firebase — separate from nonprofit admin auth)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase setup for the course:
# 1. Create a Firebase project at https://console.firebase.google.com
# 2. Authentication → Sign-in method → enable Email/Password AND Google
# 3. For Google: toggle Enable → Save (Web client ID fills in automatically)
# 4. Authentication → Settings → Authorized domains → add localhost and your Vercel URL
# 5. Create a Firestore database
# 6. Deploy firebase/firestore.rules so users can only read/write their own progress doc

# Google Sheets automation (course progress tracking)
# 1. Create a Google Sheet and paste google-apps-script/CourseTracker.gs into Apps Script
# 2. Set SPREADSHEET_ID in the script, run setup(), deploy as Web App (Anyone access)
# 3. Paste deployment URL here:
VITE_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
